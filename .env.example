# Выберите postgres или mongodb; после изменения перезапустите приложение.
DB_DRIVER=postgres
HOST=127.0.0.1
PORT=3000
# Учебные реквизиты соответствуют compose.yaml.
DATABASE_URL=postgresql://student:student_local@127.0.0.1:5432/student_api
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=student_api
